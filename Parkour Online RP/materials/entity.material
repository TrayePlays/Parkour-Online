{
    "materials": {
        "version": "1.0.0",
        "custom_transparent:entity_alphablend": {
            "+defines": [
                "COLOR_BASED",
                "USE_OVERLAY",
                "BLEND"
            ],
            "+states": [
                "Blending",
                "EnableStencilTest",
                "StencilWrite"
            ],
            "frontFace": {
                "stencilFunc": "Always",
                "stencilFailOp": "Replace",
                "stencilDepthFailOp": "Replace",
                "stencilPassOp": "Replace"
            },
            "backFace": {
                "stencilFunc": "Always",
                "stencilFailOp": "Replace",
                "stencilDepthFailOp": "Replace",
                "stencilPassOp": "Replace"
            },
            "stencilRef": 6,
            "blendSrc": "SourceAlpha",
            "blendDst": "One"
        },
        "outline_base:entity_alphatest": {
            "+defines": [
                "USE_SKINNING",
                "USE_OVERLAY"
            ],
            "+states": [
                "EnableStencilTest",
                "StencilWrite"
            ],
            "frontFace": {
                "stencilFunc": "Always",
                "stencilFailOp": "Replace",
                "stencilDepthFailOp": "Replace",
                "stencilPassOp": "Replace"
            },
            "backFace": {
                "stencilFunc": "Always",
                "stencilFailOp": "Replace",
                "stencilDepthFailOp": "Replace",
                "stencilPassOp": "Replace"
            },
            "stencilRef": 6
        },
        "outline_main:outline_base": {
            "+states": [
                "DisableDepthWrite",
                "DisableCulling"
            ],
            "frontFace": {
                "stencilFunc": "NotEqual",
                "stencilPassOp": "Keep"
            },
            "backFace": {
                "stencilFunc": "NotEqual",
                "stencilPassOp": "Keep"
            }
        }
    }
}