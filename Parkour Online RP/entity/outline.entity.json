{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "parkour:outline",
            "geometry": {
                "default": "geometry.outline_grid",
                "outline": "geometry.outline"
            },
            "textures": {
                "default": "textures/game/white"
            },
            "materials": {
                "default": "outline_main",
                "outline": "custom_transparent"
            },
            "animations": {
                "outline": "animation.outline.default",
                "outline_grid": "animation.outline_grid.default"
            },
            "scripts": {
                "should_update_bones_and_effects_offscreen": true,
                "initialize": [
                    "v.visible=false;"
                ],
                "pre_animation": [
                    "v.visible=!q.is_in_ui && query.property('parkour:visible');"
                ],
                "animate": [
                    "outline",
                    "outline_grid"
                ]
            },
            "render_controllers": [
                {
                    "controller.render.outline": "v.visible"
                },
                {
                    "controller.render.outline_base": "v.visible"
                }
            ]
        }
    }
}